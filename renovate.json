{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "forkProcessing": "enabled",
  "baseBranchPatterns": ["testing"],
  "enabledManagers": ["github-actions"],
  "automerge": false,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "GitHub Actions"
    },
    {
      "description": "BuildStream builds fail on ubuntu-26.04 runners (fsdk-containers#332); keep 24.04",
      "matchDatasources": ["github-runners"],
      "matchPackageNames": ["ubuntu"],
      "allowedVersions": "/^24\\.04(?:-arm)?$/"
    },
    {
      "description": "The released issue-lifecycle preflight requires the canonical @v1 caller.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/issue-lifecycle.yml"],
      "matchPackageNames": ["projectbluefin/actions"],
      "pinDigests": false
    }
  ]
}
